# ==============================================================================
# Fitness Tracking Platform - Production Environment Configuration Template
# ==============================================================================
# IMPORTANT: Never commit actual production secrets to version control.
# Copy this file to .env.production and populate with production vault secrets.
# NOTE: Production startup fails closed if template placeholders (CHANGE_ME..., <...>) are retained.

# ------------------------------------------------------------------------------
# Core Server Settings
# ------------------------------------------------------------------------------
NODE_ENV=production
APP_HOST=0.0.0.0
APP_PORT=3000
TRUST_PROXY=true
LOG_LEVEL=info

# Rate Limiting & DoS Protection (requests per minute per client IP; default: 100)
RATE_LIMIT_MAX=100

# ------------------------------------------------------------------------------
# Authoritative MySQL 8.x Database Configuration
# NOTE: Production fails closed unless DB_CLIENT=mysql with valid credentials.
# ------------------------------------------------------------------------------
DB_CLIENT=mysql
DATABASE_HOST=mysql
DATABASE_PORT=3306
DATABASE_NAME=fitness_platform
DATABASE_USER=fitness_user
DATABASE_PASSWORD=CHANGE_ME_SECURE_MYSQL_PASSWORD
DATABASE_ROOT_PASSWORD=CHANGE_ME_SECURE_ROOT_PASSWORD
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20

# ------------------------------------------------------------------------------
# Cryptographic Secrets (Minimum 32 characters; recommend 64+ char random hex)
# Generate with: openssl rand -hex 32
# ------------------------------------------------------------------------------
ACCESS_TOKEN_SECRET=CHANGE_ME_GENERATE_RANDOM_64_CHAR_ACCESS_SECRET
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_SECRET=CHANGE_ME_GENERATE_RANDOM_64_CHAR_REFRESH_SECRET
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECRET=CHANGE_ME_GENERATE_RANDOM_64_CHAR_COOKIE_SECRET
COOKIE_SAME_SITE=strict

# ------------------------------------------------------------------------------
# Live SMTP Email Configuration
# NOTE: Production fails closed unless EMAIL_PROVIDER=smtp with live host & credentials.
# ------------------------------------------------------------------------------
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASSWORD=CHANGE_ME_SECURE_SMTP_API_KEY
SMTP_FROM="Fitness Platform" <noreply@fitnessplatform.com>
PASSWORD_RESET_BASE_URL=https://admin.fitnessplatform.com/reset-password

# ------------------------------------------------------------------------------
# Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
ADMIN_ALLOWED_ORIGINS=https://admin.fitnessplatform.com

# ------------------------------------------------------------------------------
# Reminder Daemon Worker Settings
# ------------------------------------------------------------------------------
REMINDER_WORKER_INTERVAL_SECONDS=30

# ------------------------------------------------------------------------------
# Dashboard Nginx & Build Settings
# ------------------------------------------------------------------------------
DASHBOARD_PORT=8080
VITE_API_BASE_URL=https://api.fitnessplatform.com/api/v1
