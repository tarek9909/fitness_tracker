# Kinetic Wellness — local environment template
# Copy the backend section to backend/.env when running the API locally.
# Never commit real passwords, tokens, API keys, or production credentials.

# ------------------------------------------------------------------------------
# Backend
# ------------------------------------------------------------------------------
NODE_ENV=development
APP_HOST=0.0.0.0
APP_PORT=4000
TRUST_PROXY=false
LOG_LEVEL=info

# WebAuthn / passkeys
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Kinetic Wellness
WEBAUTHN_EXPECTED_ORIGINS=http://localhost:4000,http://localhost:5173,http://localhost:4173

# Database: sqlite is the default local option; use mysql for MySQL 8.x.
DB_CLIENT=sqlite
SQLITE_DB_PATH=./fitness_local.db
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=fitness_platform
DATABASE_USER=fitness_user
DATABASE_PASSWORD=<STRONG_LOCAL_PASSWORD>
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Security secrets (generate unique random values; use 32+ characters)
ACCESS_TOKEN_SECRET=<GENERATE_RANDOM_ACCESS_TOKEN_SECRET>
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_SECRET=<GENERATE_RANDOM_REFRESH_TOKEN_SECRET>
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECRET=<GENERATE_RANDOM_COOKIE_SECRET>
COOKIE_SAME_SITE=lax
OTP_PEPPER=<GENERATE_RANDOM_OTP_PEPPER>

# CORS and password-reset email
ADMIN_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
PASSWORD_RESET_BASE_URL=http://localhost:5173/reset-password
EMAIL_PROVIDER=mock
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<SMTP_USERNAME>
SMTP_PASSWORD=<SMTP_APP_PASSWORD>
SMTP_FROM="Kinetic Wellness" <noreply@kineticwellness.local>

# Background jobs and rate limiting
REMINDER_WORKER_INTERVAL_SECONDS=60
RATE_LIMIT_MAX=100

# ------------------------------------------------------------------------------
# Dashboard (place in admin-dashboard/.env when running the dashboard locally)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Production settings are documented in .env.production.example.
