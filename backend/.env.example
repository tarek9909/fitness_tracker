NODE_ENV=development
APP_HOST=0.0.0.0
APP_PORT=4000

# WebAuthn / passkeys. The RP ID is normally the auth host without a scheme.
WEBAUTHN_RP_ID=auth.example.com
WEBAUTHN_RP_NAME=Fitness Platform
# Comma-separated exact browser origins. Android app origins use android:apk-key-hash:<base64url-sha256-cert>.
WEBAUTHN_EXPECTED_ORIGINS=https://auth.example.com,android:apk-key-hash:REPLACE_WITH_DEBUG_OR_RELEASE_CERT_HASH
TRUST_PROXY=false

# Database Engine: 'sqlite' (verified) or 'mysql' (fail-closed / blocked)
DB_CLIENT=sqlite
SQLITE_DB_PATH=./fitness_local.db

# MySQL 8.x Settings (Required only when DB_CLIENT=mysql)
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=fitness_platform
DATABASE_USER=fitness_user
DATABASE_PASSWORD=<STRONG_LOCAL_PASSWORD>
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Security (Required in production: minimum 32 random characters)
ACCESS_TOKEN_SECRET=<GENERATE_32_CHAR_SECRET>
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_SECRET=<GENERATE_32_CHAR_SECRET>
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECRET=<GENERATE_32_CHAR_SECRET>
COOKIE_SAME_SITE=lax

# CORS Allowed Origins (Comma-separated HTTPS origins in production)
ADMIN_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Logging Level
LOG_LEVEL=info

# Email Provider: 'mock' (test/dev), 'smtp' (live email), 'none'
# For Gmail SMTP:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false (enables STARTTLS on port 587)
#   SMTP_USER=your-account@gmail.com
#   SMTP_PASSWORD=<16_CHAR_GOOGLE_APP_PASSWORD>
#   SMTP_FROM="Fitness Platform" <your-account@gmail.com>
EMAIL_PROVIDER=mock
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<SMTP_USERNAME_PLACEHOLDER>
SMTP_PASSWORD=<GOOGLE_APP_PASSWORD_PLACEHOLDER>
SMTP_FROM="Fitness Platform" <noreply@fitnessplatform.local>
OTP_PEPPER=<GENERATE_32_CHAR_SECRET>
PASSWORD_RESET_BASE_URL=http://localhost:5173/reset-password

# Background Reminder Daemon Worker
REMINDER_WORKER_INTERVAL_SECONDS=60

# Rate Limiting & DoS Protection (requests per minute per client IP; default: 100)
RATE_LIMIT_MAX=100
