{
  "name": "fitness-platform-backend",
  "version": "1.0.0",
  "description": "Authoritative REST API backend for Fitness Tracking Platform",
  "type": "module",
  "main": "dist/app/server.js",
  "scripts": {
    "dev": "tsx watch src/app/server.ts",
    "build": "tsc",
    "lint": "tsc --noEmit",
    "start": "node dist/app/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:mysql": "tsx tests/mysql-integration.ts",
    "audit:contract": "tsx src/scripts/audit-contract.ts",
    "audit:mysql": "tsx src/scripts/audit-mysql-schema.ts",
    "worker:reminders": "tsx src/workers/reminder.worker.ts",
    "start:worker": "node dist/workers/reminder.worker.js",
    "verify:mysql": "tsx src/scripts/verify-mysql-connection.ts",
    "db": "tsx src/database/init-db.ts",
    "db:init": "tsx src/database/init-db.ts",
    "db:prod": "node dist/database/init-db.js",
    "seed": "tsx src/database/seed.ts",
    "migrate": "tsx src/database/migrate.ts",
    "migrate:prod": "node dist/database/migrate.js",
    "reset:dev": "tsx src/scripts/reset-dev-db.ts"
  },
  "keywords": ["fitness", "api", "fastify", "typescript", "mysql"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "sqlite3": "^5.1.7",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.5.0",
    "@types/sqlite3": "^3.1.11",
    "@types/uuid": "^10.0.0",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
